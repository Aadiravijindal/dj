# Optional. MIXPLAY works fully without these — the assistant runs in a clearly
# labelled demo mode and the music library uses the built-in demo catalog.

# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=
# Optional model override for the creative assistant.
MIXPLAY_AI_MODEL=claude-opus-5-5
# Port for `npm start` (production server).
PORT=8787
